# -----------------------------
# Shared
# -----------------------------
APP_ENV=production
LOG_LEVEL=INFO
MASTER_ENCRYPTION_KEY=replace_with_fernet_key_base64

# Optional shared auth between bot and service
# If set, bot sends it as X-API-Key and service validates it.
MIRA_SERVICE_API_KEY=
NOTIFY_USER_ACTIVATION=true

# Optional Telegram log channel notifier
LOG_TG_ENABLED=false
LOG_TG_BOT_TOKEN=
LOG_TG_CHAT_USERNAME=
LOG_TG_CHAT_ID=
LOG_TG_MIN_LEVEL=WARNING

# Optional Bale HTTP proxy (recommended when direct DNS/network to Bale is unstable)
# Example (with provided proxy bridge): http://host.docker.internal:22080
BALE_HTTP_PROXY_URL=
BALE_NO_PROXY=localhost,127.0.0.1,mysql,rivas-mysql

# -----------------------------
# Rivas Bale Bot
# -----------------------------
BALE_BOT_TOKEN=replace_me
MIRA_SERVICE_URL=http://mira-service:8090

DB_URL=mysql://rivas:rivas@mysql:3306/rivas
# Host-side admin CLI (rivas-admin) can use localhost while containers use `mysql`.
# Example: mysql://rivas:rivas@127.0.0.1:3306/rivas
ADMIN_DB_URL=
RETENTION_DAYS=30
MAX_PHOTO_MB=10
MAX_AUDIO_MB=20
MAX_TEXT_CHUNK_CHARS=3900
STATUS_PING_SECONDS=12
REQUEST_TIMEOUT_SECONDS=320
TENANT_HEALTH_INTERVAL_SECONDS=15
TENANT_HEALTH_TIMEOUT_SECONDS=6
BOT_HEALTH_HOST=0.0.0.0
BOT_HEALTH_PORT=8080

# Dedicated tenant runtime defaults
TENANT_SERVICE_IMAGE=mira_bot_api-mira-service:latest
DOCKER_NETWORK_NAME=mira_bot_api_default
# Optional onboarding overrides used by scripts/onboard_tenant.sh
TENANT_TG_API_ID=
TENANT_TG_API_HASH=

# MySQL bootstrap
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=rivas
MYSQL_USER=rivas
MYSQL_PASSWORD=rivas
MYSQL_PORT=3306

# phpMyAdmin (localhost only)
PMA_PORT=8089

# -----------------------------
# Mira Service (Telethon bridge API)
# -----------------------------
TG_API_ID=123456
TG_API_HASH=replace_me
TG_STRING_SESSION=replace_me
# Important: do NOT run one Telegram StringSession in multiple containers at the same time.
# Each tenant must have its own Telegram account/session.
MIRA_USERNAME=@mira

QUIET_WINDOW_SECONDS=4
FIRST_RESPONSE_TIMEOUT_SECONDS=60
OVERALL_TIMEOUT_SECONDS=240
RELAY_HARD_TIMEOUT_SECONDS=320
FLOODWAIT_HARD_LIMIT_SECONDS=120
MIRA_MAX_PAYLOAD_MB=20
MIRA_API_HOST=0.0.0.0
MIRA_API_PORT=8090

# Auto-heal watchdog (Docker)
AUTOHEAL_INTERVAL=15
AUTOHEAL_CURL_TIMEOUT=10
AUTOHEAL_START_PERIOD=30

# Telegram proxy (optional)
# If DC connections time out, set TG_PROXY_ENABLED=true and configure host/port.
# If proxy runs on the Docker host itself, use TG_PROXY_HOST=host.docker.internal.
TG_PROXY_ENABLED=false
TG_PROXY_TYPE=socks5
TG_PROXY_HOST=
# Optional split override:
# - TG_PROXY_HOST_RUNTIME: host used inside tenant containers
# - TG_PROXY_HOST_ADMIN: host used by host-side admin scripts (OTP/login)
# If empty, runtime uses TG_PROXY_HOST; admin uses TG_PROXY_HOST except
# host.docker.internal which auto-falls back to 127.0.0.1.
TG_PROXY_HOST_RUNTIME=
TG_PROXY_HOST_ADMIN=
TG_PROXY_PORT=
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=
TG_PROXY_RDNS=true
