# Test profile for local/CI checks
APP_ENV=test
LOG_LEVEL=DEBUG

# Use fake token in tests that don't hit real network
BALE_BOT_TOKEN=test_token

# Point to local test instance or mocked service
MIRA_SERVICE_URL=http://127.0.0.1:18090
MIRA_SERVICE_API_KEY=test_key

DB_URL=sqlite:///data/rivas-test.db
RETENTION_DAYS=1
MAX_PHOTO_MB=10
MAX_AUDIO_MB=20
MAX_TEXT_CHUNK_CHARS=3900
STATUS_PING_SECONDS=5
REQUEST_TIMEOUT_SECONDS=30
BOT_HEALTH_HOST=127.0.0.1
BOT_HEALTH_PORT=18080

# Optional service values when running integration tests
TG_API_ID=123456
TG_API_HASH=replace_me
TG_STRING_SESSION=replace_me
MIRA_USERNAME=@mira
QUIET_WINDOW_SECONDS=2
FIRST_RESPONSE_TIMEOUT_SECONDS=15
OVERALL_TIMEOUT_SECONDS=45
FLOODWAIT_HARD_LIMIT_SECONDS=30
MIRA_MAX_PAYLOAD_MB=20
MIRA_API_HOST=127.0.0.1
MIRA_API_PORT=18090
